+fn custom_update_executable(root: Option<&std::ffi::OsStr>) -> anyhow::Result<PathBuf> {
+    let root = root.ok_or_else(|| anyhow::anyhow!("Custom update root is missing"))?;
+    let root = std::path::Path::new(root);
+    anyhow::ensure!(root.is_absolute(), "Custom update root must be absolute");
+    let executable = root.join("bin").join("codex-custom-update");
+    let metadata = std::fs::metadata(&executable).map_err(|error| {
+        anyhow::anyhow!(
+            "Custom updater {} is unavailable: {error}",
+            executable.display()
+        )
+    })?;
+    anyhow::ensure!(metadata.is_file(), "Custom updater must be a file");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        anyhow::ensure!(
+            metadata.permissions().mode() & 0o111 != 0,
+            "Custom updater is not executable"
+        );
+    }
+    Ok(executable)
+}
+
+fn run_custom_update(
+    version: codex_tui::CustomUpdateVersion,
+    root: Option<&std::ffi::OsStr>,
+) -> anyhow::Result<()> {
+    let executable = custom_update_executable(root)?;
+    println!("Updating custom Codex to {version}...");
+    let update_cwd = tempfile::tempdir()?;
+    let status = std::process::Command::new(executable)
+        .args(["--version", &version.to_string()])
+        .current_dir(update_cwd.path())
+        .status()?;
+    anyhow::ensure!(
+        status.success(),
+        "Custom update failed with status {status}"
+    );
+    println!("Update ran successfully! Please restart Codex.");
+    Ok(())
+}
