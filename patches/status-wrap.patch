+#[test]
+fn configured_fields_resize_without_overlapping_composer_input() {
+    let mut composer = composer();
+    configured_fields(&mut composer);
+    composer.set_text_content("draft".into(), Vec::new(), Vec::new());
+    for separate_status_line in [false, true] {
+        let options = ComposerRenderOptions {
+            separate_status_line,
+            ..Default::default()
+        };
+        let wide_height = composer.desired_height_with_options(80, options);
+        for width in [80, 16, 24, 80] {
+            let height = composer.desired_height_with_options(width, options);
+            let area = Rect::new(0, 0, width, height);
+            let layout = composer.layout_with_options(area, options);
+            let status = if separate_status_line {
+                layout.status
+            } else {
+                layout.footer
+            };
+            assert_eq!(layout.composer.bottom(), status.y);
+            assert!(layout.textarea.bottom() <= status.y);
+            assert_eq!(
+                status.height,
+                if width == 80 {
+                    1
+                } else if width == 16 {
+                    4
+                } else {
+                    2
+                }
+            );
+            assert_eq!(height, wide_height + status.height - 1);
+
+            let mut buf = Buffer::empty(area);
+            composer.render_with_options(area, &mut buf, None, options);
+            let rows = (status.y..status.bottom())
+                .map(|y| {
+                    (0..width)
+                        .map(|x| strip_osc8(buf[(x, y)].symbol()))
+                        .collect::<String>()
+                })
+                .collect::<Vec<_>>();
+            for field in ["MODEL", "~/project", "main", "12k tokens"] {
+                assert!(
+                    rows.iter().any(|row| row.contains(field)),
+                    "{width}: {rows:?}"
+                );
+            }
+            assert!(
+                composer
+                    .cursor_pos_with_options(area, options)
+                    .is_some_and(|(_, y)| y < status.y)
+            );
+        }
+    }
+}
