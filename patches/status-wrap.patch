+            (StatusLineItem::CurrentDir, "~/project".into()),
+            (StatusLineItem::GitBranch, "main".into()),
+            (StatusLineItem::UsedTokens, "12k tokens".into()),
+        ],
+        false,
+        None,
+        None,
+    ));
